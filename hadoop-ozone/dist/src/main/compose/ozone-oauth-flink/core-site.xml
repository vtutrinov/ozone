<configuration>
  <!-- Default FS points at Ozone — HMS resolves relative
       warehouse paths against this. -->
  <property>
    <name>fs.defaultFS</name>
    <value>ofs://om</value>
  </property>
  <property>
    <name>fs.AbstractFileSystem.ofs.impl</name>
    <value>org.apache.hadoop.fs.ozone.RootedOzFs</value>
  </property>
  <property>
    <name>fs.ofs.impl</name>
    <value>org.apache.hadoop.fs.ozone.RootedOzoneFileSystem</value>
  </property>

  <!-- Secure mode — agent intercepts the Kerberos login flow. -->
  <property>
    <name>hadoop.security.authentication</name>
    <value>kerberos</value>
  </property>
  <property>
    <name>hadoop.security.authorization</name>
    <value>true</value>
  </property>
  <property>
    <name>hadoop.security.auth_to_local</name>
    <value>DEFAULT</value>
  </property>

  <!-- Same impersonation knobs as ozone-oauth — testuser is
       allowed to act on behalf of anyone for end-to-end OAuth
       tests. HMS will doAs(submitter) for client requests. -->
  <property>
    <name>hadoop.proxyuser.hms.hosts</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hms.groups</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hms.users</name>
    <value>*</value>
  </property>

  <!-- Hive's result-fetch path calls
       TokenCache.obtainTokensForNamenodes(), which asks Hadoop's
       Master.getMasterPrincipal() for a delegation-token renewer.
       Without a value here it throws "Can't get Master Kerberos
       principal for use as renewer". We have no real RM in this
       suite — the principal string is only used as the renewer
       label, never actually contacted. -->
  <property>
    <name>yarn.resourcemanager.principal</name>
    <value>rm/_HOST@EXAMPLE.COM</value>
  </property>
</configuration>
