# Split-Kerberos deployments turn off Ratis-level TLS in favor of mesh mTLS
# (Istio etc.). Required when interservice=false — leaving it true would
# cause TLS-asymmetry between Ratis peers (HTTP/2 client preface errors).
OZONE-SITE.XML_hdds.grpc.tls.enabled=false
OZONE-SITE.XML_ozone.server.default.replication=3
OZONE-SITE.XML_ozone.datanode.pipeline.limit=1
OZONE-SITE.XML_hdds.scmclient.max.retry.timeout=30s

OZONE-SITE.XML_ozone.recon.om.snapshot.task.interval.delay=1m
