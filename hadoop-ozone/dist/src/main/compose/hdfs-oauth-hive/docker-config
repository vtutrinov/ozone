# Secure plain-HDFS without a KDC — same trick as ../hdfs-oauth,
# consumed by the NameNode/DataNode containers via envtoconf.
# The Hive containers get their config from the bind-mounted
# core-site.xml / hive-site.xml instead.

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:9000
CORE-SITE.XML_fs.trash.interval=1
CORE-SITE.XML_hadoop.security.authentication=kerberos
CORE-SITE.XML_hadoop.security.authorization=true
CORE-SITE.XML_hadoop.security.auth_to_local=DEFAULT

# The NameNode must accept impersonated (doAs) requests from HMS —
# HiveServer2 runs queries as the connecting user and HMS forwards
# that identity.
CORE-SITE.XML_hadoop.proxyuser.hms.hosts=*
CORE-SITE.XML_hadoop.proxyuser.hms.groups=*
CORE-SITE.XML_hadoop.proxyuser.hms.users=*

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:9000
HDFS-SITE.XML_dfs.namenode.kerberos.principal=nn/namenode@EXAMPLE.COM
HDFS-SITE.XML_dfs.namenode.keytab.file=/etc/security/keytabs/nn.keytab
HDFS-SITE.XML_dfs.datanode.kerberos.principal=dn/datanode@EXAMPLE.COM
HDFS-SITE.XML_dfs.datanode.keytab.file=/etc/security/keytabs/dn.keytab
HDFS-SITE.XML_dfs.block.access.token.enable=true
HDFS-SITE.XML_dfs.data.transfer.protection=authentication
HDFS-SITE.XML_ignore.secure.ports.for.testing=true
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.permissions.enabled=true
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false

no_proxy=namenode,datanode,hms,hiveserver2,postgres,keycloak,localhost,127.0.0.1
