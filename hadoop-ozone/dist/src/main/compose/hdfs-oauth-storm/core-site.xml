<configuration>
  <!-- Default FS points at plain HDFS — Spark resolves paths against this. No Ozone filesystem impls
       needed: hdfs:// is native to the Hadoop libs Hive ships. -->
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode:9000</value>
  </property>

  <!-- Secure mode — agent intercepts the Kerberos login flow. -->
  <property>
    <name>hadoop.security.authentication</name>
    <value>kerberos</value>
  </property>
  <property>
    <name>hadoop.security.authorization</name>
    <value>true</value>
  </property>
  <property>
    <name>hadoop.security.auth_to_local</name>
    <value>DEFAULT</value>
  </property>

  <!-- HDFS client side of the secure cluster: the expected NN
       service principal and the SASL protection level on the
       DataNode data-transfer path (DIGEST-MD5 via block tokens). -->
  <property>
    <name>dfs.namenode.kerberos.principal</name>
    <value>nn/namenode@EXAMPLE.COM</value>
  </property>
  <property>
    <name>dfs.data.transfer.protection</name>
    <value>authentication</value>
  </property>


  <!-- Hive's result-fetch path calls
       TokenCache.obtainTokensForNamenodes(), which asks Hadoop's
       Master.getMasterPrincipal() for a delegation-token renewer.
       Without a value here it throws "Can't get Master Kerberos
       principal for use as renewer". We have no RM in this suite —
       the principal string is only used as the renewer label. -->
  <property>
    <name>yarn.resourcemanager.principal</name>
    <value>rm/_HOST@EXAMPLE.COM</value>
  </property>
</configuration>
