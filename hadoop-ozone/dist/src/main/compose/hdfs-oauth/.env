# This suite is Ozone-free: it runs plain HDFS + YARN from the stock
# Apache Hadoop image, so it does NOT depend on the Ozone dist tarball.
# Only the security-auth-agent jar is taken from the build tree, which
# is why the values here are literal instead of Maven placeholders —
# the suite is runnable directly from src/main/compose.
HADOOP_IMAGE=ghcr.io/apache/hadoop
HADOOP_VERSION=3.4.2-lean
AGENT_JAR=../../../../../security-auth-agent/target/security-auth-agent-2.2.0-SNAPSHOT.jar
