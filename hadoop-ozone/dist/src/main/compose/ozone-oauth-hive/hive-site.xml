<configuration>
  <!-- Warehouse on Ozone — every CREATE DATABASE/TABLE without
       an explicit LOCATION lands here. -->
  <property>
    <name>metastore.warehouse.dir</name>
    <value>ofs://om/volume1/bucket1/warehouse</value>
  </property>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>ofs://om/volume1/bucket1/warehouse</value>
  </property>

  <!-- HMS Thrift endpoint -->
  <property>
    <name>metastore.thrift.uris</name>
    <value>thrift://hms:9083</value>
  </property>
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hms:9083</value>
  </property>
  <property>
    <name>metastore.thrift.port</name>
    <value>9083</value>
  </property>

  <!-- Postgres backend (also passed via SERVICE_OPTS as -D, but
       repeated here so schematool reads them when initialising). -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:postgresql://postgres:5432/metastore</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.postgresql.Driver</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>hive</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>hive</value>
  </property>

  <!-- Security: HMS uses Kerberos SASL on its Thrift port.
       The security-auth-agent intercepts UGI.loginUserFromKeytab,
       acquires an OAuth JWT (AUTH_LOGIN=hms), and synthesises a
       Kerberos-shaped UGI from the JWT. The keytab path below
       never gets read. -->
  <property>
    <name>metastore.kerberos.principal</name>
    <value>hms/hms@EXAMPLE.COM</value>
  </property>
  <property>
    <name>hive.metastore.kerberos.principal</name>
    <value>hms/hms@EXAMPLE.COM</value>
  </property>
  <property>
    <name>metastore.kerberos.keytab.file</name>
    <value>/etc/security/keytabs/hms.keytab</value>
  </property>
  <property>
    <name>hive.metastore.kerberos.keytab.file</name>
    <value>/etc/security/keytabs/hms.keytab</value>
  </property>
  <!-- HMS thrift SASL is on. The security-auth-agent registers a
       JCA SASL provider (OAuthSaslProvider) at premain so Hive's
       TSaslServerTransport gets our OAuthSaslServer instead of
       the JDK default GSSAPI server, and TSaslClientTransport
       gets OAuthSaslClient on the HS2 side. JWT carried in the
       SASL initial response replaces the Kerberos ticket. -->
  <property>
    <name>metastore.use.thrift.sasl</name>
    <value>true</value>
  </property>
  <property>
    <name>hive.metastore.sasl.enabled</name>
    <value>true</value>
  </property>

  <!-- Disable HMS schema auto-creation — we run schematool
       explicitly in init-schema.sh against postgres. -->
  <property>
    <name>datanucleus.schema.autoCreateAll</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>true</value>
  </property>

  <!-- HiveServer2 — its own Kerberos principal/keytab. With
       hadoop.security.authentication=kerberos (core-site.xml) HS2
       requires a configured keytab login for itself even when it
       accepts plain-TCP clients. The agent intercepts the
       loginUserFromKeytab call before Hadoop ever reads the
       (non-existent) keytab file. Client-facing auth is set to
       NONE because the Hive thrift SASL path isn't intercepted
       by the agent yet — beeline connects plain-TCP. -->
  <property>
    <name>hive.server2.authentication</name>
    <value>NONE</value>
  </property>
  <property>
    <name>hive.server2.authentication.kerberos.principal</name>
    <value>hms/_HOST@EXAMPLE.COM</value>
  </property>
  <property>
    <name>hive.server2.authentication.kerberos.keytab</name>
    <value>/etc/security/keytabs/hms.keytab</value>
  </property>
  <!-- doAs ON: HS2 runs each query as the connecting user (via
       UGI.doAs), so Ozone writes get the client's identity as
       owner instead of the HS2 service principal. The proxyuser
       chain (hms is allowed to impersonate any user per
       core-site.xml's hadoop.proxyuser.hms.*) lets HMS forward
       the proxied identity to OM. -->
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>true</value>
  </property>

  <!-- Tez execution engine. mr was removed in Hive 4 and would
       otherwise fall back to LocalJobRunner; we point at Tez in
       local mode (see tez-site.xml) so the in-JVM Tez AM/tasks
       drive query execution. -->
  <property>
    <name>hive.execution.engine</name>
    <value>tez</value>
  </property>

  <!-- HMS proxy-user config. Same settings live in core-site.xml
       too, but Hive 4's classpath puts /opt/hadoop/etc/hadoop
       ahead of /opt/hive/conf, and the image's default
       /opt/hadoop/etc/hadoop/core-site.xml is empty — so the
       proxyuser entries effectively get masked out. Repeat them
       here so the Hive Configuration always sees them. -->
  <property>
    <name>hadoop.proxyuser.hms.hosts</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hms.groups</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hms.users</name>
    <value>*</value>
  </property>
  <!-- Tez session reuse — keeps the AM warm across queries. -->
  <property>
    <name>hive.tez.exec.print.summary</name>
    <value>true</value>
  </property>

  <!-- Hive scratch lives on the LOCAL filesystem (file:// scheme)
       inside the HS2 container, not on ofs://. Two reasons:
         1. Tez in local mode wants its log/working dir under a
            local path (file:/.../_tez_session_dir/<id>/.tez/
            <app>_wd/localmode-log-dir) and stumbles when given an
            ofs path.
         2. The default /tmp/hive lands on ofs://om/tmp/hive in
            this cluster (fs.defaultFS=ofs://om), and ofs decodes
            that as volume=tmp, bucket=hive — which doesn't exist.
       Real query output still goes to ofs:// (the database
       LOCATION in CREATE DATABASE is on Ozone); only scratch is
       container-local. -->
  <property>
    <name>hive.exec.scratchdir</name>
    <value>file:///tmp/hive</value>
  </property>
  <property>
    <name>hive.exec.local.scratchdir</name>
    <value>/tmp/hive-local</value>
  </property>
</configuration>
