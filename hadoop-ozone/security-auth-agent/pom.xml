<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.apache.ozone</groupId>
    <artifactId>ozone</artifactId>
    <version>2.2.0-SNAPSHOT</version>
  </parent>
  <artifactId>security-auth-agent</artifactId>
  <version>2.2.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Apache Ozone Tools</name>
  <description>Apache Ozone Tools</description>

  <properties>
    <agent.class>${premain.class}</agent.class>
    <classpath.skip>false</classpath.skip>
    <!-- Default values for the agent/premain classes. Update these to the actual agent implementation class in this module. -->
    <premain.class>org.apache.ozone.SecurityAuthAgent</premain.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>1.17.7</version>
    </dependency>
    <!--
      hadoop-common is provided-scope: compile-time access to TokenIdentifier,
      TokenRenewer, Token, UserGroupInformation, Credentials, etc.
      Not bundled into the shaded JAR — comes from the application classloader
      at runtime when the agent runs inside a Hadoop service.
    -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- The class whose premain(String, Instrumentation) method will be invoked by the JVM -->
              <Premain-Class>${premain.class}</Premain-Class>
              <!-- Supporting Agent-Class in case runtime attach is needed -->
              <Agent-Class>${agent.class}</Agent-Class>
              <!-- Allow redefinition/retransformation if agent needs it -->
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
              <Can-Retransform-Classes>true</Can-Retransform-Classes>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!-- Avoid generating dependency-reduced POM for this module -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!-- Relocate ByteBuddy to avoid conflicts with application dependencies -->
              <relocations>
                <relocation>
                  <pattern>net.bytebuddy</pattern>
                  <shadedPattern>${ozone.shaded.prefix}.net.bytebuddy</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <!-- Ensure the shaded jar contains the agent manifest entries -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>${premain.class}</Premain-Class>
                    <Agent-Class>${agent.class}</Agent-Class>
                    <Can-Redefine-Classes>true</Can-Redefine-Classes>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                    <!--
                      Intentionally NO Boot-Class-Path entry. Putting the
                      agent jar on the bootstrap classloader means our
                      OAuthTokenRenewer (extends hadoop's TokenRenewer)
                      gets loaded by the bootstrap CL, which cannot see
                      hadoop-common -> NoClassDefFoundError when
                      Token.getRenewer() runs ServiceLoader on RM.
                      Letting -javaagent put the jar on the system
                      classloader is sufficient for ByteBuddy
                      interception of Hadoop classes.
                    -->
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
