+package org.apache.ranger.authorization.ozone.authorizer;
+
+import org.apache.hadoop.metrics2.MetricsCollector;
+import org.apache.hadoop.metrics2.MetricsRecordBuilder;
+import org.apache.hadoop.metrics2.MetricsSource;
+import org.apache.hadoop.metrics2.lib.Interns;
+
+/**
+ * Hadoop metrics2 source for the policy-cache guard. Registered with the
+ * host process' DefaultMetricsSystem (the OzoneManager's), which makes the
+ * metrics available on the OM HTTP server's /prom endpoint (Ozone's
+ * PrometheusMetricsSink exports every metrics2 source) as
+ * ranger_policy_cache_guard_* gauges/counters, as well as via the metrics
+ * system's own JMX beans.
+ *
+ * The metrics2 interfaces are loaded from the host (OM) classloader's
+ * hadoop-common, so this class - like the authorizer itself - is bound to
+ * the same class identities as the host process.
+ */
+public class RangerOzoneCacheGuardMetricsSource implements MetricsSource {
+	public static final String SOURCE_NAME   = "RangerOzoneCacheGuard";
+	public static final String RECORD_NAME   = "RangerPolicyCacheGuard";
+	public static final String CONTEXT_NAME  = "ranger";
+
+	private final RangerOzoneCacheGuard guard;
+
+	public RangerOzoneCacheGuardMetricsSource(RangerOzoneCacheGuard guard) {
+		this.guard = guard;
+	}
+
+	@Override
+	public void getMetrics(MetricsCollector collector, boolean all) {
+		MetricsRecordBuilder rb = collector.addRecord(RECORD_NAME)
+				.setContext(CONTEXT_NAME)
+				.tag(Interns.info("state", "Current cache state"), guard.getState());
+
+		rb.addGauge(Interns.info("HitCount",
+				"Access checks evaluated against a valid cache in the current state window"), guard.getHitCount());
+		rb.addGauge(Interns.info("MissCount",
+				"Access checks denied by the cache guard in the current state window"), guard.getMissCount());
+		rb.addCounter(Interns.info("TotalHitCount",
+				"Access checks evaluated against a valid cache since plugin start"), guard.getTotalHitCount());
+		rb.addCounter(Interns.info("TotalMissCount",
+				"Access checks denied by the cache guard since plugin start"), guard.getTotalMissCount());
+		rb.addGauge(Interns.info("CurrentPolicySize",
+				"Number of policies currently in the policy engine (incl. security zones)"), guard.getCurrentPolicySize());
+		rb.addGauge(Interns.info("CurrentRoleSize",
+				"Number of roles currently cached"), guard.getCurrentRoleSize());
+		rb.addCounter(Interns.info("ExtendTTLTotalCount",
+				"Cache validity extension operations since plugin start"), guard.getExtendTTLTotalCount());
+		rb.addCounter(Interns.info("InvalidateTotalCount",
+				"Cache invalidation operations (whole cache and per-entry) since plugin start"), guard.getInvalidateTotalCount());
+		rb.addGauge(Interns.info("CacheStateOrdinal",
+				"Cache state as ordinal: 0=DISABLED 1=FRESH 2=EXTENDED 3=EXPIRED 4=INVALIDATED"),
+				guard.state().ordinal());
+		rb.addGauge(Interns.info("MsSinceLastAdminContact",
+				"Milliseconds since the last successful Ranger Admin round-trip"), guard.getMsSinceLastContact());
+	}
+}
diff --git a/plugin-ozone/src/test/java/org/apache/ranger/authorization/ozone/authorizer/TestRangerOzoneCacheGuard.java b/plugin-ozone/src/test/java/org/apache/ranger/authorization/ozone/authorizer/TestRangerOzoneCacheGuard.java
new file mode 100644
index 000000000..fe3a30e5f
--- /dev/null
+++ b/plugin-ozone/src/test/java/org/apache/ranger/authorization/ozone/authorizer/TestRangerOzoneCacheGuard.java
@@ -0,0 +1,253 @@
+/*
