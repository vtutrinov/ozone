+					// instead of a full policy list. Rebuilding it here would
+					// wipe all zone policies - pass the zone through as-is
+					// (the named policy cannot be filtered from this zone).
+					zonesCopy.put(entry.getKey(), zone);
+					continue;
+				}
+
+				ServicePolicies.SecurityZoneInfo zoneCopy = new ServicePolicies.SecurityZoneInfo();
+
+				zoneCopy.setZoneName(zone.getZoneName());
+				zoneCopy.setResources(zone.getResources());
+				zoneCopy.setContainsAssociatedTagService(zone.getContainsAssociatedTagService());
+				zoneCopy.setPolicyDeltas(null);
+
+				List<RangerPolicy> zoneFiltered = new ArrayList<>();
+				for (RangerPolicy policy : zone.getPolicies()) {
+					if (policyName.equals(policy.getName())) {
+						found = true;
+					} else {
