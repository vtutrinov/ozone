+package org.apache.ranger.authorization.ozone.authorizer;
+
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.function.IntSupplier;
+import java.util.function.LongSupplier;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import com.google.gson.JsonObject;
+
+/**
+ * Fail-closed state machine for the ozone plugin policy cache.
+ *
+ * The cache is considered valid while Ranger Admin has been successfully
+ * contacted within the configured expiry interval, or while an
+ * administrator-granted validity extension is in effect. When the cache is
+ * expired or explicitly invalidated, every access check must be denied.
+ *
+ * Metrics: a "hit" is an access check evaluated against a valid cache, a
+ * "miss" is an access check denied by the guard. hitCount/missCount cover
+ * the current cache-state window (reset on every state transition);
+ * totalHitCount/totalMissCount cover the plugin lifetime.
+ *
+ * All state is in-memory and node-local; nothing survives a process
+ * restart. Thread-safe without locks: single volatile/atomic fields only.
+ */
+public class RangerOzoneCacheGuard implements RangerOzoneCacheGuardMXBean {
+	private static final Logger LOG = LoggerFactory.getLogger(RangerOzoneCacheGuard.class);
+
+	private static final long DENY_LOG_INTERVAL_MS = 30 * 1000L;
+
+	/** Cache lifecycle states. */
+	public enum State { DISABLED, FRESH, EXTENDED, EXPIRED, INVALIDATED }
+
+	private final long         expiryMs;
+	private final long         initTimeMs;
+	private final LongSupplier clock;
+	private final LongSupplier lastContactSupplier;
+	private final IntSupplier  policySizeSupplier;
+	private final IntSupplier  roleSizeSupplier;
+
+	private final AtomicLong invalidatedAtMs      = new AtomicLong(0);
+	private final AtomicLong extensionDeadlineMs  = new AtomicLong(0);
+	private final AtomicLong lastDenyLogTimeMs    = new AtomicLong(0);
+	private final AtomicReference<State> lastLoggedState = new AtomicReference<>(null);
+
+	// current cache-state window (reset on every state transition)
+	private final AtomicLong hitCount             = new AtomicLong(0);
+	private final AtomicLong missCount            = new AtomicLong(0);
+	// plugin lifetime
+	private final AtomicLong totalHitCount        = new AtomicLong(0);
+	private final AtomicLong totalMissCount       = new AtomicLong(0);
+	private final AtomicLong extendTTLTotalCount  = new AtomicLong(0);
+	private final AtomicLong invalidateTotalCount = new AtomicLong(0);
+
+	// NOTE: no lambdas/method references in this module - the PMD version
+	// used by the build fails to parse them
+	private static final LongSupplier SYSTEM_CLOCK = new LongSupplier() {
+		@Override
+		public long getAsLong() {
+			return System.currentTimeMillis();
+		}
+	};
+
+	public RangerOzoneCacheGuard(long expiryMs, LongSupplier lastContactSupplier,
+			IntSupplier policySizeSupplier, IntSupplier roleSizeSupplier) {
+		this(expiryMs, lastContactSupplier, policySizeSupplier, roleSizeSupplier, SYSTEM_CLOCK);
+	}
+
+	// visible for testing: injectable clock
+	RangerOzoneCacheGuard(long expiryMs, LongSupplier lastContactSupplier,
+			IntSupplier policySizeSupplier, IntSupplier roleSizeSupplier, LongSupplier clock) {
+		this.expiryMs            = expiryMs;
+		this.lastContactSupplier = lastContactSupplier;
+		this.policySizeSupplier  = policySizeSupplier;
+		this.roleSizeSupplier    = roleSizeSupplier;
+		this.clock               = clock;
+		this.initTimeMs          = clock.getAsLong();
+	}
+
+	public State state() {
+		long now         = clock.getAsLong();
+		long lastContact = lastContactSupplier.getAsLong();
+		long invalidated = invalidatedAtMs.get();
+
+		// explicit invalidation holds until a successful admin contact
+		// newer than the invalidation; it wins over extensions
+		if (invalidated > 0 && lastContact <= invalidated) {
+			return State.INVALIDATED;
+		}
+
+		if (expiryMs <= 0) {
+			return State.DISABLED;
+		}
+
+		long extension = extensionDeadlineMs.get();
+		long deadline  = Math.max(lastContact + expiryMs, extension);
+
+		if (now > deadline) {
+			return State.EXPIRED;
+		}
+
+		return now > lastContact + expiryMs ? State.EXTENDED : State.FRESH;
+	}
+
+	/**
+	 * @return true when access checks may be evaluated against the cached
+	 * policies; false when they must be denied unconditionally.
+	 */
+	public boolean allowAccess() {
+		State state = current();
+
+		if (state == State.EXPIRED || state == State.INVALIDATED) {
+			missCount.incrementAndGet();
+			totalMissCount.incrementAndGet();
+
+			long now     = clock.getAsLong();
+			long lastLog = lastDenyLogTimeMs.get();
+
+			if (now - lastLog > DENY_LOG_INTERVAL_MS && lastDenyLogTimeMs.compareAndSet(lastLog, now)) {
+				LOG.warn("Denying all accesses: policy cache is " + state
+						+ " (lastSuccessfulAdminContact=" + lastContactSupplier.getAsLong()
+						+ ", expiryMs=" + expiryMs
+						+ ", deniedSoFar=" + totalMissCount.get() + ")");
+			}
+
+			return false;
+		}
+
+		hitCount.incrementAndGet();
+		totalHitCount.incrementAndGet();
+
+		return true;
+	}
+
+	public void invalidate() {
+		invalidatedAtMs.set(clock.getAsLong());
+		invalidateTotalCount.incrementAndGet();
+		current();
+	}
+
+	/**
+	 * Counts a per-entry (policy/role) invalidation, which affects the
+	 * policy engine but not the guard state.
+	 */
+	public void recordEntryInvalidation() {
+		invalidateTotalCount.incrementAndGet();
+	}
+
+	public void extendValidity(long extensionMs) {
+		extensionDeadlineMs.set(clock.getAsLong() + extensionMs);
+		extendTTLTotalCount.incrementAndGet();
+		current();
+	}
+
+	public long getExpiryMs() {
+		return expiryMs;
+	}
+
+	@Override
+	public String getState() {
+		return current().name();
+	}
+
+	@Override
+	public long getTtlMs() {
+		return expiryMs;
+	}
+
+	@Override
+	public long getHitCount() {
+		return hitCount.get();
+	}
+
+	@Override
+	public long getMissCount() {
+		return missCount.get();
+	}
+
+	@Override
+	public long getTotalHitCount() {
+		return totalHitCount.get();
+	}
+
+	@Override
+	public long getTotalMissCount() {
+		return totalMissCount.get();
+	}
+
+	@Override
+	public int getCurrentPolicySize() {
+		return policySizeSupplier.getAsInt();
+	}
+
+	@Override
+	public int getCurrentRoleSize() {
+		return roleSizeSupplier.getAsInt();
+	}
+
+	@Override
+	public long getExtendTTLTotalCount() {
+		return extendTTLTotalCount.get();
+	}
+
+	@Override
+	public long getInvalidateTotalCount() {
+		return invalidateTotalCount.get();
+	}
+
+	@Override
+	public long getLastSuccessfulAdminContactMs() {
+		return lastContactSupplier.getAsLong();
+	}
+
+	@Override
+	public long getMsSinceLastContact() {
+		return clock.getAsLong() - lastContactSupplier.getAsLong();
+	}
+
+	public String statusJson(String serviceName, long policiesVersion, long rolesVersion) {
+		long  now         = clock.getAsLong();
+		long  lastContact = lastContactSupplier.getAsLong();
+		State state       = current();
+
+		JsonObject json = new JsonObject();
+		json.addProperty("serviceName", serviceName);
+		json.addProperty("state", state.name());
+		json.addProperty("ttlMs", expiryMs);
+		json.addProperty("pluginInitTimeMs", initTimeMs);
+		json.addProperty("lastSuccessfulAdminContactMs", lastContact);
+		json.addProperty("msSinceLastContact", now - lastContact);
+		json.addProperty("effectiveDeadlineMs",
+				expiryMs > 0 ? Math.max(lastContact + expiryMs, extensionDeadlineMs.get()) : -1);
+		json.addProperty("extensionDeadlineMs", extensionDeadlineMs.get());
+		json.addProperty("invalidatedAtMs", invalidatedAtMs.get());
+		json.addProperty("policiesVersion", policiesVersion);
+		json.addProperty("rolesVersion", rolesVersion);
+		json.addProperty("hitCount", hitCount.get());
+		json.addProperty("missCount", missCount.get());
+		json.addProperty("totalHitCount", totalHitCount.get());
+		json.addProperty("totalMissCount", totalMissCount.get());
+		json.addProperty("currentPolicySize", policySizeSupplier.getAsInt());
+		json.addProperty("currentRoleSize", roleSizeSupplier.getAsInt());
+		json.addProperty("extendTTLTotalCount", extendTTLTotalCount.get());
+		json.addProperty("invalidateTotalCount", invalidateTotalCount.get());
+
+		return json.toString();
+	}
+
+	// evaluates the state, logs transitions at INFO and resets the
+	// per-window hit/miss counters when the state changes
+	private State current() {
+		State state = state();
+		State prev  = lastLoggedState.getAndSet(state);
+
+		if (prev != null && prev != state) {
+			LOG.info("Policy cache state changed: " + prev + " -> " + state
+					+ " (window counters reset; hits=" + hitCount.get() + ", misses=" + missCount.get() + ")");
+			hitCount.set(0);
+			missCount.set(0);
+		}
+
+		return state;
+	}
+}
