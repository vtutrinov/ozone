+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+package org.apache.ranger.authorization.ozone.authorizer;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.IntSupplier;
+import java.util.function.LongSupplier;
+
+import org.apache.ranger.authorization.ozone.authorizer.RangerOzoneCacheGuard.State;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class TestRangerOzoneCacheGuard {
+	private static final long TTL = 60_000L;
+
+	private final AtomicLong    now         = new AtomicLong(1_000_000L);
+	private final AtomicLong    lastContact = new AtomicLong(1_000_000L);
+	private final AtomicInteger policySize  = new AtomicInteger(5);
+	private final AtomicInteger roleSize    = new AtomicInteger(2);
+
+	// anonymous classes instead of method references: the PMD version used
+	// by the build fails to parse them
+	static LongSupplier longSupplier(final AtomicLong value) {
+		return new LongSupplier() {
+			@Override
+			public long getAsLong() {
+				return value.get();
+			}
+		};
+	}
+
+	static IntSupplier intSupplier(final AtomicInteger value) {
+		return new IntSupplier() {
+			@Override
+			public int getAsInt() {
+				return value.get();
+			}
+		};
+	}
+
+	private RangerOzoneCacheGuard newGuard(long expiryMs) {
+		return new RangerOzoneCacheGuard(expiryMs, longSupplier(lastContact),
+				intSupplier(policySize), intSupplier(roleSize), longSupplier(now));
+	}
+
+	@Test
+	public void disabledTtlNeverExpires() {
+		RangerOzoneCacheGuard guard = newGuard(0);
+
+		now.addAndGet(365L * 24 * 3600 * 1000); // a year without contact
+
+		Assert.assertEquals(State.DISABLED, guard.state());
+		Assert.assertTrue(guard.allowAccess());
+	}
+
+	@Test
+	public void freshWithinTtl() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		now.addAndGet(TTL - 1);
+
+		Assert.assertEquals(State.FRESH, guard.state());
+		Assert.assertTrue(guard.allowAccess());
+	}
+
+	@Test
+	public void expiresAfterTtl() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		now.addAndGet(TTL + 1);
+
+		Assert.assertEquals(State.EXPIRED, guard.state());
+		Assert.assertFalse(guard.allowAccess());
+	}
+
+	@Test
+	public void successfulContactRevivesExpiredCache() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		now.addAndGet(TTL + 1);
+		Assert.assertFalse(guard.allowAccess());
+
+		lastContact.set(now.get()); // refresher reached Ranger Admin again
+
+		Assert.assertEquals(State.FRESH, guard.state());
+		Assert.assertTrue(guard.allowAccess());
+	}
+
+	@Test
+	public void extensionRevivesExpiredCache() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		now.addAndGet(TTL + 1);
+		Assert.assertEquals(State.EXPIRED, guard.state());
+
+		guard.extendValidity(10_000);
+
+		Assert.assertEquals(State.EXTENDED, guard.state());
+		Assert.assertTrue(guard.allowAccess());
+
+		now.addAndGet(10_001); // extension deadline passes
+
+		Assert.assertEquals(State.EXPIRED, guard.state());
+		Assert.assertFalse(guard.allowAccess());
+	}
+
+	@Test
+	public void invalidateDeniesEvenWhenTtlDisabled() {
+		RangerOzoneCacheGuard guard = newGuard(0);
+
+		guard.invalidate();
+
+		Assert.assertEquals(State.INVALIDATED, guard.state());
+		Assert.assertFalse(guard.allowAccess());
+	}
+
+	@Test
+	public void invalidationClearedByNewerAdminContact() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		now.addAndGet(1000);
+		guard.invalidate();
+		Assert.assertEquals(State.INVALIDATED, guard.state());
+
+		now.addAndGet(1000);
+		lastContact.set(now.get()); // successful sync after invalidation
+
+		Assert.assertEquals(State.FRESH, guard.state());
+		Assert.assertTrue(guard.allowAccess());
+	}
+
+	@Test
+	public void extendDoesNotOverrideInvalidation() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		now.addAndGet(1000);
+		guard.invalidate();
+		guard.extendValidity(3600_000);
+
+		Assert.assertEquals(State.INVALIDATED, guard.state());
+		Assert.assertFalse(guard.allowAccess());
+	}
+
+	@Test
+	public void hitAndMissCountersTrackAccessOutcomes() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		guard.allowAccess();
+		guard.allowAccess();
+		guard.allowAccess();
+
+		Assert.assertEquals(3, guard.getHitCount());
+		Assert.assertEquals(3, guard.getTotalHitCount());
+		Assert.assertEquals(0, guard.getMissCount());
+		Assert.assertEquals(0, guard.getTotalMissCount());
+
+		now.addAndGet(TTL + 1); // expire
+
+		guard.allowAccess(); // miss
+		guard.allowAccess(); // miss
+
+		Assert.assertEquals(2, guard.getMissCount());
+		Assert.assertEquals(2, guard.getTotalMissCount());
+		Assert.assertEquals(3, guard.getTotalHitCount());
+	}
+
+	@Test
+	public void windowCountersResetOnStateTransitionTotalsDoNot() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		guard.allowAccess(); // hit in FRESH window
+		guard.allowAccess();
+
+		now.addAndGet(TTL + 1);
+		guard.allowAccess(); // FRESH->EXPIRED transition, then miss
+
+		Assert.assertEquals("window hit counter must reset on transition", 0, guard.getHitCount());
+		Assert.assertEquals(1, guard.getMissCount());
+
+		lastContact.set(now.get()); // recover
+		guard.allowAccess(); // EXPIRED->FRESH transition, then hit
+
+		Assert.assertEquals(1, guard.getHitCount());
+		Assert.assertEquals("window miss counter must reset on transition", 0, guard.getMissCount());
+
+		Assert.assertEquals("totals survive transitions", 3, guard.getTotalHitCount());
+		Assert.assertEquals("totals survive transitions", 1, guard.getTotalMissCount());
+	}
+
+	@Test
+	public void operationCountersAndSizes() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		guard.extendValidity(10_000);
+		guard.extendValidity(10_000);
+		guard.invalidate();
+		guard.recordEntryInvalidation(); // per-policy/per-role invalidation
+
+		Assert.assertEquals(2, guard.getExtendTTLTotalCount());
+		Assert.assertEquals(2, guard.getInvalidateTotalCount());
+
+		policySize.set(42);
+		roleSize.set(7);
+
+		Assert.assertEquals(42, guard.getCurrentPolicySize());
+		Assert.assertEquals(7, guard.getCurrentRoleSize());
+	}
+
+	@Test
+	public void statusJsonReflectsStateAndMetrics() {
+		RangerOzoneCacheGuard guard = newGuard(TTL);
+
+		guard.allowAccess(); // hit while FRESH
+
+		now.addAndGet(TTL + 1);
+		guard.allowAccess(); // transition to EXPIRED + miss
+		guard.extendValidity(10_000); // EXPIRED -> EXTENDED transition
+		guard.allowAccess(); // hit in EXTENDED window
+
+		String json = guard.statusJson("ozone", 42L, 7L);
+
+		Assert.assertTrue(json.contains("\"state\":\"EXTENDED\""));
+		Assert.assertTrue(json.contains("\"policiesVersion\":42"));
+		Assert.assertTrue(json.contains("\"rolesVersion\":7"));
+		Assert.assertTrue(json.contains("\"ttlMs\":" + TTL));
+		Assert.assertTrue(json.contains("\"hitCount\":1"));
+		Assert.assertTrue(json.contains("\"missCount\":0"));
+		Assert.assertTrue(json.contains("\"totalHitCount\":2"));
+		Assert.assertTrue(json.contains("\"totalMissCount\":1"));
+		Assert.assertTrue(json.contains("\"currentPolicySize\":5"));
+		Assert.assertTrue(json.contains("\"currentRoleSize\":2"));
+		Assert.assertTrue(json.contains("\"extendTTLTotalCount\":1"));
+		Assert.assertTrue(json.contains("\"invalidateTotalCount\":0"));
+	}
+}
