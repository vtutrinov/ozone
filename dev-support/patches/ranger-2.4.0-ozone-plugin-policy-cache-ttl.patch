+package org.apache.ranger.authorization.ozone.authorizer;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+
+import org.apache.hadoop.metrics2.AbstractMetric;
+import org.apache.hadoop.metrics2.MetricsRecord;
+import org.apache.hadoop.metrics2.impl.MetricsCollectorImpl;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class TestRangerOzoneCacheGuardMetricsSource {
+
+	@Test
+	public void exportsAllCacheMetrics() {
+		AtomicLong    now         = new AtomicLong(1_000_000L);
+		AtomicLong    lastContact = new AtomicLong(1_000_000L);
+		AtomicInteger policySize  = new AtomicInteger(11);
+		AtomicInteger roleSize    = new AtomicInteger(3);
+
+		RangerOzoneCacheGuard guard = new RangerOzoneCacheGuard(60_000L,
+				TestRangerOzoneCacheGuard.longSupplier(lastContact),
+				TestRangerOzoneCacheGuard.intSupplier(policySize),
+				TestRangerOzoneCacheGuard.intSupplier(roleSize),
+				TestRangerOzoneCacheGuard.longSupplier(now));
+
+		guard.allowAccess();            // hit
+		guard.extendValidity(10_000);   // extend op
+		guard.recordEntryInvalidation();
+
+		RangerOzoneCacheGuardMetricsSource source = new RangerOzoneCacheGuardMetricsSource(guard);
+		MetricsCollectorImpl collector = new MetricsCollectorImpl();
+
+		source.getMetrics(collector, true);
+
+		MetricsRecord record = collector.getRecords().get(0);
+		Assert.assertEquals(RangerOzoneCacheGuardMetricsSource.RECORD_NAME, record.name());
+		Assert.assertEquals(RangerOzoneCacheGuardMetricsSource.CONTEXT_NAME, record.context());
+
+		long found = 0;
+		for (AbstractMetric metric : record.metrics()) {
+			switch (metric.name()) {
+			case "HitCount":             Assert.assertEquals(1L,  metric.value().longValue()); found++; break;
+			case "MissCount":            Assert.assertEquals(0L,  metric.value().longValue()); found++; break;
+			case "TotalHitCount":        Assert.assertEquals(1L,  metric.value().longValue()); found++; break;
+			case "TotalMissCount":       Assert.assertEquals(0L,  metric.value().longValue()); found++; break;
+			case "CurrentPolicySize":    Assert.assertEquals(11L, metric.value().longValue()); found++; break;
+			case "CurrentRoleSize":      Assert.assertEquals(3L,  metric.value().longValue()); found++; break;
+			case "ExtendTTLTotalCount":  Assert.assertEquals(1L,  metric.value().longValue()); found++; break;
+			case "InvalidateTotalCount": Assert.assertEquals(1L,  metric.value().longValue()); found++; break;
+			default: break;
+			}
+		}
+		Assert.assertEquals("all 8 cache metrics must be exported", 8, found);
+	}
+}
