+	@Override
+	public boolean invalidateCachedPolicy(String policyName) throws IOException {
+		RangerOzoneCacheGuard guard = requireGuard();
+
+		ServicePolicies snapshot = rangerPlugin.getLastAppliedServicePolicies();
+		if (snapshot == null) {
+			throw new IOException("No policy snapshot available yet - the plugin has not applied any policies");
+		}
