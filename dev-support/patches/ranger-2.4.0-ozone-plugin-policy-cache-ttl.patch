+		boolean found = false;
+
+		ServicePolicies copy = new ServicePolicies();
+		copy.setServiceName(snapshot.getServiceName());
+		copy.setServiceId(snapshot.getServiceId());
+		// version -1, NOT the snapshot version: setPolicies persists this
+		// filtered copy to the disk policy-cache, and after an OM restart
+		// the version from the cache file becomes lastKnownVersion. With
+		// the original version Ranger Admin would answer 304 forever and
+		// the invalidated policy would never be restored.
+		copy.setPolicyVersion(-1L);
+		copy.setPolicyUpdateTime(snapshot.getPolicyUpdateTime());
+		copy.setServiceDef(snapshot.getServiceDef());
+		copy.setAuditMode(snapshot.getAuditMode());
+		copy.setTagPolicies(snapshot.getTagPolicies());
+		copy.setServiceConfig(snapshot.getServiceConfig());
+		copy.setPolicyDeltas(null); // force the full-snapshot path in setPolicies
+
+		List<RangerPolicy> filtered = new ArrayList<>();
+		if (snapshot.getPolicies() != null) {
+			for (RangerPolicy policy : snapshot.getPolicies()) {
+				if (policyName.equals(policy.getName())) {
+					found = true;
+				} else {
+					filtered.add(policy);
+				}
+			}
+		}
+		copy.setPolicies(filtered);
+
+		if (snapshot.getSecurityZones() != null) {
+			Map<String, ServicePolicies.SecurityZoneInfo> zonesCopy = new HashMap<>();
+			for (Map.Entry<String, ServicePolicies.SecurityZoneInfo> entry : snapshot.getSecurityZones().entrySet()) {
+				ServicePolicies.SecurityZoneInfo zone = entry.getValue();
+
