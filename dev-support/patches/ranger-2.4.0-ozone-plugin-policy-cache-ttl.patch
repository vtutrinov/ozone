+
+package org.apache.ranger.plugin.util;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+import org.apache.hadoop.conf.Configuration;
+import org.apache.ranger.admin.client.AbstractRangerAdminClient;
+import org.apache.ranger.plugin.service.RangerBasePlugin;
+import org.junit.After;
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Verifies that PolicyRefresher advances the last-successful-admin-contact
+ * timestamp on successful round-trips (both "updated" and "no update"
+ * responses) and does NOT advance it when Ranger Admin is unreachable.
+ */
+public class TestPolicyRefresherAdminContact {
+
+	enum StubMode { NO_UPDATE, FAIL }
+
+	private static volatile StubMode stubMode = StubMode.NO_UPDATE;
+	private static final AtomicLong LAST_REQUESTED_POLICY_VERSION = new AtomicLong(Long.MIN_VALUE);
+
+	/**
+	 * Stub admin client: "no update" (returns null) or connection failure.
+	 */
+	public static class StubAdminClient extends AbstractRangerAdminClient {
+		@Override
+		public void init(String serviceName, String appId, String configPropertyPrefix, Configuration config) {
+		}
+
+		@Override
+		public ServicePolicies getServicePoliciesIfUpdated(long lastKnownVersion, long lastActivationTimeInMillis) throws Exception {
+			LAST_REQUESTED_POLICY_VERSION.set(lastKnownVersion);
+
+			if (stubMode == StubMode.FAIL) {
+				throw new Exception("simulated: Ranger Admin unreachable");
+			}
+
+			return null; // 304 - no update
+		}
+
+		@Override
+		public RangerRoles getRolesIfUpdated(long lastKnownRoleVersion, long lastActivationTimeInMills) throws Exception {
+			if (stubMode == StubMode.FAIL) {
+				throw new Exception("simulated: Ranger Admin unreachable");
+			}
+
+			return null; // 304 - no update
+		}
+	}
+
+	private PolicyRefresher refresher;
+
+	@After
+	public void cleanup() {
+		if (refresher != null) {
+			refresher.stopRefresher();
+			refresher = null;
+		}
+	}
+
+	private PolicyRefresher newRefresher() {
+		RangerBasePlugin plugin = new RangerBasePlugin("ozone", "testsvc", "testapp");
+
+		plugin.getConfig().set("ranger.plugin.ozone.policy.source.impl", StubAdminClient.class.getName());
+		plugin.getConfig().set("ranger.plugin.ozone.policy.cache.dir", "target/policycache-" + System.nanoTime());
+		plugin.getConfig().set("ranger.plugin.ozone.policy.pollIntervalMs", "3600000");
+
+		return new PolicyRefresher(plugin);
+	}
+
+	private void forceRefreshCycle() throws InterruptedException {
+		refresher.syncPoliciesWithAdmin(new DownloadTrigger());
+	}
+
+	@Test
+	public void contactTimeAdvancesOnNoUpdateButNotOnFailure() throws Exception {
+		stubMode  = StubMode.NO_UPDATE;
+		refresher = newRefresher();
+
+		long beforeStart = refresher.getLastActiveAdminContactTimeMs();
+
+		Thread.sleep(5);
+		refresher.startRefresher(); // initial synchronous load, "no update"
+
+		long afterNoUpdate = refresher.getLastActiveAdminContactTimeMs();
+		Assert.assertTrue("contact time must advance on a 'no update' response",
+				afterNoUpdate > beforeStart);
+
+		stubMode = StubMode.FAIL;
+		Thread.sleep(5);
+		forceRefreshCycle();
+
+		Assert.assertEquals("contact time must NOT advance while admin is unreachable",
+				afterNoUpdate, refresher.getLastActiveAdminContactTimeMs());
+
+		stubMode = StubMode.NO_UPDATE;
+		Thread.sleep(5);
+		forceRefreshCycle();
+
+		Assert.assertTrue("contact time must advance again after admin recovers",
+				refresher.getLastActiveAdminContactTimeMs() > afterNoUpdate);
+	}
+
+	@Test
+	public void resetForcesFullDownloadOnNextCycle() throws Exception {
+		stubMode  = StubMode.NO_UPDATE;
+		refresher = newRefresher();
+
+		refresher.startRefresher();
+		Assert.assertEquals(-1L, LAST_REQUESTED_POLICY_VERSION.get());
+
+		// no updated policies were returned, so lastKnownVersion stays -1;
+		// simulate a known version to see the reset take effect
+		refresher.setLastActivationTimeInMillis(System.currentTimeMillis());
+
+		refresher.resetLastKnownVersions();
+		forceRefreshCycle();
+
+		Assert.assertEquals("reset must force a full (version -1) download request",
+				-1L, LAST_REQUESTED_POLICY_VERSION.get());
+	}
+}
