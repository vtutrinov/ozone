+    private static boolean openIndex(RestClient restClient, String index) throws IOException {
+        Response response = restClient.performRequest(new Request("POST", "/" + index + "/_open"));
+        JsonElement acknowledged = JsonParser.parseString(EntityUtils.toString(response.getEntity()))
