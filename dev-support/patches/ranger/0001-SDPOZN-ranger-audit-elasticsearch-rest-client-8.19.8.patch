+    static String getBulkItemFailure(JsonElement item) {
+        JsonObject result = item.getAsJsonObject().entrySet().iterator().next().getValue().getAsJsonObject();
+        JsonElement error = result.get("error");
+        if (error != null && !error.isJsonNull()) {
+            return error.toString();
+        }
+        int status = result.has("status") ? result.get("status").getAsInt() : 0;
+        return status >= 300 ? "HTTP " + status : null;
+    }
