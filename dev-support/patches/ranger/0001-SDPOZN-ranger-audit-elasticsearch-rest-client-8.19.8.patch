+/**
+ * Tests {@link ElasticSearchAuditDestination} against a stub Elasticsearch
+ * HTTP endpoint.
+ */
+public class TestElasticSearchAuditDestination {
+
+    private static final String INDEX = "ranger_audits";
+
+    private HttpServer server;
+    private final List<String> requests = new CopyOnWriteArrayList<>();
+    private volatile String bulkResponse;
+
+    @Before
+    public void setUp() throws IOException {
+        server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        server.createContext("/", this::handle);
+        server.start();
+    }
+
+    @After
+    public void tearDown() {
+        server.stop(0);
+    }
+
+    @Test
+    public void indexesEventsWithBulkApi() throws Exception {
+        bulkResponse = "{\"took\":3,\"errors\":false,\"items\":["
+                + "{\"index\":{\"_index\":\"" + INDEX + "\",\"_id\":\"e1\",\"status\":201}},"
+                + "{\"index\":{\"_index\":\"" + INDEX + "\",\"_id\":\"e2\",\"status\":201}}]}";
+        ElasticSearchAuditDestination destination = newDestination();
+
+        assertTrue(destination.log(Arrays.asList(event("e1"), event("e2"))));
+
+        assertEquals("POST /" + INDEX + "/_open", requests.get(0).split("\n", 2)[0]);
+        String bulk = requests.get(1);
+        String[] lines = bulk.split("\n");
+        assertEquals("POST /_bulk", lines[0]);
+        // action + source line per event
+        assertEquals(5, lines.length);
+        JsonObject action = JsonParser.parseString(lines[1]).getAsJsonObject().getAsJsonObject("index");
+        assertEquals(INDEX, action.get("_index").getAsString());
+        assertEquals("e1", action.get("_id").getAsString());
+        JsonObject doc = JsonParser.parseString(lines[2]).getAsJsonObject();
+        assertEquals("e1", doc.get("id").getAsString());
+        assertEquals("alice", doc.get("reqUser").getAsString());
+        assertEquals("1970-01-01T00:00:01.234Z", doc.get("evtTime").getAsString());
+        assertEquals("[\"PII\"]", doc.get("tags").toString());
+        assertTrue(doc.has("zoneName") && doc.get("zoneName").isJsonNull());
+    }
+
+    @Test
+    public void failedBulkItemsAreNotSuccess() throws Exception {
+        bulkResponse = "{\"took\":3,\"errors\":true,\"items\":["
+                + "{\"index\":{\"_index\":\"" + INDEX + "\",\"_id\":\"e1\",\"status\":400,"
+                + "\"error\":{\"type\":\"mapper_parsing_exception\",\"reason\":\"bad\"}}}]}";
+        ElasticSearchAuditDestination destination = newDestination();
+
+        assertFalse(destination.log(Collections.singletonList(event("e1"))));
+    }
+
+    @Test
+    public void httpErrorIsNotSuccess() throws Exception {
+        bulkResponse = null; // stub answers 500
+        ElasticSearchAuditDestination destination = newDestination();
+
+        assertFalse(destination.log(new ArrayList<AuditEventBase>(Collections.singletonList(event("e1")))));
+    }
+
+    private ElasticSearchAuditDestination newDestination() {
+        String prefix = ElasticSearchAuditDestination.CONFIG_PREFIX;
+        Properties props = new Properties();
+        props.setProperty(prefix + "." + ElasticSearchAuditDestination.CONFIG_URLS, "127.0.0.1");
+        props.setProperty(prefix + "." + ElasticSearchAuditDestination.CONFIG_PORT,
+                String.valueOf(server.getAddress().getPort()));
+        props.setProperty(prefix + "." + ElasticSearchAuditDestination.CONFIG_USER, "elastic");
+        props.setProperty(prefix + "." + ElasticSearchAuditDestination.CONFIG_PWRD, "secret");
+        ElasticSearchAuditDestination destination = new ElasticSearchAuditDestination();
+        destination.init(props, prefix);
+        return destination;
+    }
+
+    private static AuthzAuditEvent event(String id) {
+        AuthzAuditEvent event = new AuthzAuditEvent();
+        event.setEventId(id);
+        event.setUser("alice");
+        event.setEventTime(new Date(1234));
+        event.setTags(new HashSet<>(Collections.singletonList("PII")));
+        return event;
+    }
+
+    private void handle(HttpExchange exchange) throws IOException {
+        String path = exchange.getRequestURI().getPath();
+        requests.add(exchange.getRequestMethod() + " " + path + "\n" + read(exchange.getRequestBody()));
+        String body;
+        int status;
+        if (path.endsWith("/_open")) {
+            status = 200;
+            body = "{\"acknowledged\":true,\"shards_acknowledged\":true}";
+        } else if (bulkResponse != null) {
+            status = 200;
+            body = bulkResponse;
+        } else {
+            status = 500;
+            body = "{\"error\":\"boom\"}";
+        }
+        byte[] bytes = body.getBytes(StandardCharsets.UTF_8);
+        exchange.getResponseHeaders().add("Content-Type", "application/json");
+        exchange.sendResponseHeaders(status, bytes.length);
+        try (OutputStream out = exchange.getResponseBody()) {
+            out.write(bytes);
+        }
+    }
+
+    private static String read(InputStream in) throws IOException {
+        ByteArrayOutputStream buf = new ByteArrayOutputStream();
+        byte[] chunk = new byte[4096];
+        int n;
+        while ((n = in.read(chunk)) > 0) {
+            buf.write(chunk, 0, n);
+        }
+        return new String(buf.toByteArray(), StandardCharsets.UTF_8);
+    }
+}
