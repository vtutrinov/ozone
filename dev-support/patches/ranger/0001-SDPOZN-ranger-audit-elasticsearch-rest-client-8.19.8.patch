+            target.addProperty("_index", index);
+            target.addProperty("_id", authzEvent.getEventId());
+            JsonObject action = new JsonObject();
+            action.add("index", target);
+            body.append(GSON.toJson(action)).append('\n');
+            body.append(GSON.toJson(toDoc(authzEvent))).append('\n');
+        }
+        return body.toString();
+    }
